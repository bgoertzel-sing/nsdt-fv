def ba_add : Nat Nat -> Nat
  ba_add(Z, m) = m
  ba_add(S(n), m) = S(ba_add(n, m))
def ba_mul : Nat Nat -> Nat
  ba_mul(Z, m) = Z
  ba_mul(S(n), m) = ba_add(m, ba_mul(n, m))
def ba_dbl : Nat -> Nat
  ba_dbl(Z) = Z
  ba_dbl(S(n)) = S(S(ba_dbl(n)))
def ba_pred : Nat -> Nat
  ba_pred(Z) = Z
  ba_pred(S(n)) = n
def ba_sub : Nat Nat -> Nat
  ba_sub(n, Z) = n
  ba_sub(n, S(m)) = ba_pred(ba_sub(n, m))
def ba_neg : Bool -> Bool
  ba_neg(T) = F
  ba_neg(F) = T
def ba_even : Nat -> Bool
  ba_even(Z) = T
  ba_even(S(n)) = ba_neg(ba_even(n))
def ba_andb : Bool Bool -> Bool
  ba_andb(T, b) = b
  ba_andb(F, b) = F
def ba_tri : Nat -> Nat
  ba_tri(Z) = Z
  ba_tri(S(n)) = S(ba_add(n, ba_tri(n)))
def ba_w0 : Nat Nat -> Nat
  ba_w0(x0, x1) = ba_dbl(ba_add(x0, x1))
def ba_w1 : Nat Nat -> Nat
  ba_w1(x0, x1) = ba_sub(ba_pred(x0), ba_pred(x1))
def ba_w2 : Nat Nat -> Nat
  ba_w2(x0, x1) = ba_pred(ba_add(x0, x1))
def ba_w3 : Nat Nat -> Bool
  ba_w3(x0, x1) = ba_even(ba_add(x0, x1))
def ba_w4 : Nat Nat -> Nat
  ba_w4(x0, x1) = ba_tri(ba_sub(x0, x1))
def ba_w5 : Nat -> Nat
  ba_w5(x0) = ba_pred(x0)
def ba_w6 : Nat Nat -> Nat
  ba_w6(x0, x1) = ba_add(ba_w5(x0), ba_w5(x1))
def ba_w7 : Nat Nat Nat -> Nat
  ba_w7(x0, x1, x2) = ba_w2(x0, ba_add(x1, x2))
lemma ba_add_z_r : forall n. ba_add(n, Z) = n
  by induct n { simp refl } { simp rw IH refl }
lemma ba_add_s_r : forall n m. ba_add(n, S(m)) = S(ba_add(n, m))
  by induct n { simp refl } { simp rw IH refl }
lemma ba_add_assoc : forall n m k. ba_add(ba_add(n, m), k) = ba_add(n, ba_add(m, k))
  by induct n { simp refl } { simp rw IH refl }
lemma ba_add_comm : forall n m. ba_add(n, m) = ba_add(m, n)
  by induct n { simp rw ba_add_z_r refl } { simp rw IH rw ba_add_s_r refl }
lemma ba_mul_z_r : forall n. ba_mul(n, Z) = Z
  by induct n { simp refl } { simp rw IH refl }
lemma ba_mul_one : forall n. ba_mul(n, S(Z)) = n
  by induct n { simp refl } { simp rw IH refl }
lemma ba_mul_add : forall n m k. ba_mul(ba_add(n, m), k) = ba_add(ba_mul(n, k), ba_mul(m, k))
  by induct n { simp refl } { simp rw IH rw ba_add_assoc refl }
lemma ba_mul_assoc : forall n m k. ba_mul(ba_mul(n, m), k) = ba_mul(n, ba_mul(m, k))
  by induct n { simp refl } { simp rw<- IH rw ba_mul_add refl }
lemma ba_dbl_add : forall n. ba_dbl(n) = ba_add(n, n)
  by induct n { simp refl } { simp rw IH rw ba_add_s_r refl }
lemma ba_neg_neg : forall b. ba_neg(ba_neg(b)) = b
  by cases b { simp refl } { simp refl }
lemma ba_even_dbl : forall n. ba_even(ba_dbl(n)) = T
  by induct n { simp refl } { simp rw IH simp refl }
lemma ba_sub_z_l : forall n. ba_sub(Z, n) = Z
  by induct n { simp refl } { simp rw IH simp refl }
lemma ba_andb_t_r : forall b. ba_andb(b, T) = b
  by cases b { simp refl } { simp refl }
lemma ba_andb_comm : forall b c. ba_andb(b, c) = ba_andb(c, b)
  by cases b { simp rw ba_andb_t_r refl } { simp cases c { simp refl } { simp refl } }
lemma ba_even_ss : forall n. ba_even(S(S(n))) = ba_even(n)
  by simp rw ba_neg_neg refl
lemma ba_pred_add_s : forall n m. ba_pred(ba_add(n, S(m))) = ba_add(n, m)
  by rw ba_add_s_r simp refl
lemma ba_d001 : forall n m. ba_even(S(S(ba_mul(n, m)))) = ba_even(ba_mul(n, m))
  by simp rw ba_neg_neg refl
lemma ba_d002 : forall n m. ba_even(ba_dbl(ba_add(n, m))) = T
  by rw ba_even_dbl refl
lemma ba_d003 : forall n. ba_add(n, Z) = ba_add(Z, n)
  by simp rw ba_add_z_r refl
lemma ba_d004 : forall n m. ba_neg(ba_neg(ba_w3(n, m))) = ba_w3(n, m)
  by simp rw ba_neg_neg refl
lemma ba_d005 : forall n. ba_mul(ba_pred(n), S(Z)) = ba_pred(n)
  by rw ba_mul_one refl
lemma ba_d006 : forall b. ba_andb(b, F) = ba_andb(F, b)
  by simp rw ba_andb_comm simp refl
lemma ba_d007 : forall n m. ba_mul(ba_mul(n, m), Z) = ba_mul(n, ba_mul(m, Z))
  by rw ba_mul_assoc refl
lemma ba_d008 : ba_neg(ba_neg(F)) = F
  by simp refl
lemma ba_d009 : forall n m. ba_w3(n, m) = ba_even(ba_add(n, m))
  by simp refl
lemma ba_d010 : ba_add(Z, Z) = Z
  by simp refl
lemma ba_d011 : forall n. ba_even(S(S(S(n)))) = ba_even(S(n))
  by simp rw ba_neg_neg refl
lemma ba_d012 : forall n m. ba_w0(n, m) = ba_dbl(ba_add(n, m))
  by simp refl
lemma ba_d015 : forall n m. ba_sub(Z, ba_w1(n, m)) = Z
  by simp rw ba_sub_z_l refl
lemma ba_d016 : forall n m. ba_add(ba_add(n, m), Z) = ba_add(n, m)
  by rw ba_d003 simp refl
lemma ba_d017 : forall n. ba_mul(ba_dbl(n), S(Z)) = ba_dbl(n)
  by rw ba_mul_one refl
lemma ba_d018 : forall n. ba_even(ba_add(n, n)) = T
  by rw<- ba_dbl_add rw ba_even_dbl refl
lemma ba_d019 : forall n m. ba_w2(n, S(m)) = ba_add(n, m)
  by simp rw ba_pred_add_s refl
lemma ba_d020 : forall n m k. ba_add(ba_add(ba_pred(n), m), k) = ba_add(ba_pred(n), ba_add(m, k))
  by rw ba_add_assoc refl
lemma ba_d021 : forall n m. ba_even(ba_dbl(ba_w1(n, m))) = T
  by simp rw ba_even_dbl refl
lemma ba_d022 : ba_neg(ba_neg(T)) = T
  by simp refl
lemma ba_d023 : forall b. ba_andb(b, T) = ba_andb(T, b)
  by simp rw ba_andb_t_r refl
lemma ba_d024 : forall n m k. ba_mul(ba_mul(S(n), m), k) = ba_mul(S(n), ba_mul(m, k))
  by simp rw ba_mul_add rw ba_mul_assoc refl
lemma ba_d025 : forall n m k. ba_pred(ba_add(ba_add(n, m), S(k))) = ba_add(ba_add(n, m), k)
  by rw ba_pred_add_s refl
lemma ba_d026 : forall n. ba_add(ba_tri(n), Z) = ba_tri(n)
  by rw ba_d003 simp refl
lemma ba_d028 : forall n m k. ba_add(n, ba_sub(m, k)) = ba_add(ba_sub(m, k), n)
  by rw ba_add_comm refl
lemma ba_d029 : forall n m k i. ba_add(ba_add(n, ba_sub(m, k)), i) = ba_add(n, ba_add(ba_sub(m, k), i))
  by rw ba_add_assoc refl
lemma ba_d030 : forall n. ba_pred(ba_add(Z, S(n))) = ba_add(Z, n)
  by simp refl
lemma ba_d032 : forall n. ba_sub(Z, ba_tri(n)) = Z
  by rw ba_sub_z_l refl
lemma ba_d033 : forall n. ba_neg(ba_neg(ba_w3(n, Z))) = ba_w3(n, Z)
  by simp rw ba_neg_neg refl
lemma ba_d034 : forall n b. ba_andb(ba_even(n), b) = ba_andb(b, ba_even(n))
  by rw ba_andb_comm refl
lemma ba_d035 : ba_sub(Z, Z) = Z
  by simp refl
lemma ba_d036 : forall n m k. ba_pred(ba_add(ba_w1(n, m), S(k))) = ba_add(ba_w1(n, m), k)
  by simp rw ba_pred_add_s refl
lemma ba_d037 : forall n. ba_dbl(S(n)) = ba_add(S(n), S(n))
  by simp rw ba_dbl_add rw ba_add_s_r refl
lemma ba_d038 : ba_mul(Z, S(Z)) = Z
  by simp refl
lemma ba_d039 : forall n m k. ba_pred(ba_add(n, S(ba_w0(m, k)))) = ba_add(n, ba_w0(m, k))
  by simp rw ba_pred_add_s refl
lemma ba_d040 : forall n m. ba_neg(ba_neg(ba_w3(n, ba_tri(m)))) = ba_w3(n, ba_tri(m))
  by simp rw ba_neg_neg refl
lemma ba_d043 : forall n m k i. ba_add(n, ba_sub(m, ba_w2(k, i))) = ba_add(ba_sub(m, ba_w2(k, i)), n)
  by simp rw ba_d028 refl
lemma ba_d045 : forall n m. ba_add(ba_add(n, m), Z) = ba_add(Z, ba_add(n, m))
  by simp rw ba_d016 refl
lemma ba_d046 : forall n. ba_even(S(S(ba_mul(n, Z)))) = ba_even(ba_mul(n, Z))
  by simp rw ba_neg_neg refl
lemma ba_d047 : forall n m. ba_andb(ba_w3(n, m), T) = ba_w3(n, m)
  by simp rw ba_d034 simp refl
lemma ba_d048 : forall n m. ba_add(S(n), S(m)) = S(ba_add(S(n), m))
  by simp rw ba_add_s_r refl
lemma ba_d049 : forall n m. ba_dbl(ba_sub(n, m)) = ba_add(ba_sub(n, m), ba_sub(n, m))
  by rw ba_dbl_add refl
lemma ba_d050 : forall n. ba_add(S(n), Z) = S(n)
  by simp rw ba_d003 simp refl
lemma ba_d051 : forall n m k. ba_w3(ba_w2(n, m), k) = ba_even(ba_add(ba_w2(n, m), k))
  by simp refl
lemma ba_d053 : forall n m k. ba_w2(ba_add(n, m), S(k)) = ba_add(ba_add(n, m), k)
  by simp rw ba_d025 refl
lemma ba_d054 : forall n m. ba_w1(n, m) = ba_sub(ba_pred(n), ba_pred(m))
  by simp refl
lemma ba_d055 : forall n m. ba_w2(n, m) = ba_pred(ba_add(n, m))
  by simp refl
lemma ba_d056 : forall n m k i. ba_add(n, ba_sub(m, ba_w0(k, i))) = ba_add(ba_sub(m, ba_w0(k, i)), n)
  by simp rw ba_d028 refl
lemma ba_d057 : forall n m. ba_even(ba_w0(n, m)) = T
  by simp rw ba_d002 refl
lemma ba_d058 : forall n m k. ba_w2(ba_w0(n, m), S(k)) = ba_add(ba_w0(n, m), k)
  by simp rw ba_pred_add_s refl
lemma ba_d059 : forall n. ba_even(S(S(S(S(n))))) = ba_even(S(S(n)))
  by simp rw ba_neg_neg refl
lemma ba_d061 : forall n. ba_w3(n, n) = T
  by simp rw ba_d018 refl
lemma ba_d062 : forall n m k. ba_neg(ba_neg(ba_w3(ba_sub(n, m), ba_tri(k)))) = ba_w3(ba_sub(n, m), ba_tri(k))
  by simp rw ba_neg_neg refl
lemma ba_d066 : forall n m k. ba_add(ba_w2(n, m), k) = ba_add(k, ba_w2(n, m))
  by simp rw ba_add_comm refl
lemma ba_d068 : forall n m k. ba_even(S(S(ba_mul(n, ba_w0(m, k))))) = ba_even(ba_mul(n, ba_w0(m, k)))
  by simp rw ba_neg_neg refl
lemma ba_d069 : forall n m. ba_sub(Z, ba_sub(n, m)) = Z
  by rw ba_sub_z_l refl
lemma ba_d070 : forall b. ba_andb(ba_neg(b), T) = ba_neg(b)
  by rw ba_d023 simp refl
lemma ba_d072 : forall n. ba_dbl(ba_sub(n, Z)) = ba_add(ba_sub(n, Z), ba_sub(n, Z))
  by simp rw ba_dbl_add refl
lemma ba_d073 : forall n m k. ba_add(ba_add(ba_pred(S(n)), m), k) = ba_add(ba_pred(S(n)), ba_add(m, k))
  by simp rw ba_add_assoc refl
lemma ba_d074 : forall n. ba_mul(ba_pred(S(n)), S(Z)) = ba_pred(S(n))
  by simp rw ba_mul_one refl
lemma ba_d076 : forall n m k. ba_pred(ba_add(n, S(ba_mul(m, k)))) = ba_add(n, ba_mul(m, k))
  by rw ba_pred_add_s refl
lemma ba_d078 : forall n m k. ba_even(ba_dbl(ba_add(n, ba_sub(m, k)))) = T
  by rw ba_d002 refl
lemma ba_d079 : forall n m. ba_neg(ba_neg(ba_w3(n, ba_tri(S(m))))) = ba_w3(n, ba_tri(S(m)))
  by simp rw ba_add_s_r simp rw ba_add_s_r simp rw ba_neg_neg refl
lemma ba_d080 : forall n. ba_andb(ba_even(n), F) = ba_andb(F, ba_even(n))
  by simp rw ba_d034 simp refl
lemma ba_d081 : forall n m. ba_even(S(S(ba_add(n, m)))) = ba_even(ba_add(n, m))
  by simp rw ba_neg_neg refl
lemma ba_d083 : forall b c. ba_andb(ba_neg(b), c) = ba_andb(c, ba_neg(b))
  by rw ba_andb_comm refl
lemma ba_d084 : forall n. ba_mul(n, ba_add(S(Z), Z)) = n
  by simp rw ba_mul_one refl
lemma ba_d085 : forall n m k. ba_add(ba_w2(n, S(m)), k) = ba_add(k, ba_w2(n, S(m)))
  by simp rw ba_pred_add_s rw ba_pred_add_s rw ba_add_comm refl
lemma ba_d087 : forall n m k. ba_dbl(ba_sub(n, ba_w2(m, k))) = ba_add(ba_sub(n, ba_w2(m, k)), ba_sub(n, ba_w2(m, k)))
  by simp rw ba_d049 refl
lemma ba_d088 : forall n m. ba_mul(ba_pred(ba_add(n, m)), S(Z)) = ba_pred(ba_add(n, m))
  by rw ba_d005 refl
lemma ba_d089 : forall n m k i. ba_w3(ba_w2(n, ba_w1(m, k)), i) = ba_even(ba_add(ba_w2(n, ba_w1(m, k)), i))
  by simp refl
lemma ba_d090 : forall n m. ba_add(ba_add(ba_tri(n), m), Z) = ba_add(Z, ba_add(ba_tri(n), m))
  by simp rw ba_d045 simp refl
lemma ba_d091 : forall n. ba_neg(ba_neg(ba_w3(Z, n))) = ba_w3(Z, n)
  by simp rw ba_neg_neg refl
lemma ba_d092 : forall n m k. ba_even(S(S(ba_mul(n, ba_w0(S(m), k))))) = ba_even(ba_mul(n, ba_w0(S(m), k)))
  by simp induct n { simp refl } { simp rw<- ba_d076 rw<- ba_d081 simp rw ba_d076 refl }
lemma ba_d093 : forall n m k. ba_dbl(ba_sub(n, ba_mul(m, k))) = ba_add(ba_sub(n, ba_mul(m, k)), ba_sub(n, ba_mul(m, k)))
  by rw ba_d049 refl
lemma ba_d094 : forall n m k. ba_even(ba_w0(n, ba_sub(m, k))) = T
  by simp rw ba_d078 refl
lemma ba_d095 : forall n m k. ba_w2(n, ba_sub(m, k)) = ba_pred(ba_add(n, ba_sub(m, k)))
  by simp refl
lemma ba_d096 : forall n. ba_add(S(n), Z) = ba_add(Z, S(n))
  by simp rw ba_d003 simp refl
lemma ba_d097 : forall n m. ba_w2(n, ba_pred(m)) = ba_pred(ba_add(n, ba_pred(m)))
  by simp refl
lemma ba_d098 : forall n m. ba_sub(Z, ba_tri(ba_w1(n, m))) = Z
  by simp rw ba_d032 refl
lemma ba_d099 : forall n m k. ba_neg(ba_neg(ba_w3(ba_sub(n, m), ba_tri(S(k))))) = ba_w3(ba_sub(n, m), ba_tri(S(k)))
  by simp rw<- ba_d028 simp rw<- ba_d028 simp rw ba_neg_neg refl
lemma ba_d101 : forall n. ba_pred(ba_add(Z, S(ba_pred(n)))) = ba_add(Z, ba_pred(n))
  by simp refl
lemma ba_d102 : forall n. ba_even(S(S(ba_mul(ba_pred(n), Z)))) = ba_even(ba_mul(ba_pred(n), Z))
  by simp rw ba_neg_neg refl
lemma ba_d103 : forall n. ba_pred(ba_add(Z, S(S(n)))) = ba_add(Z, S(n))
  by simp refl
lemma ba_d104 : forall n m. ba_pred(ba_add(Z, S(ba_mul(n, m)))) = ba_add(Z, ba_mul(n, m))
  by simp refl
lemma ba_d105 : forall n m k. ba_neg(ba_neg(ba_w3(n, ba_tri(ba_w2(m, k))))) = ba_w3(n, ba_tri(ba_w2(m, k)))
  by simp rw ba_neg_neg refl
lemma ba_d106 : forall n m k i. ba_pred(ba_add(ba_w2(n, m), S(ba_w0(k, i)))) = ba_add(ba_w2(n, m), ba_w0(k, i))
  by simp rw ba_pred_add_s refl
lemma ba_d107 : forall n. ba_even(ba_dbl(ba_add(Z, n))) = T
  by simp rw ba_even_dbl refl
lemma ba_d109 : ba_andb(ba_even(Z), F) = ba_andb(F, ba_even(Z))
  by simp refl
lemma ba_d110 : forall n m k. ba_add(ba_add(ba_pred(S(S(n))), m), k) = ba_add(ba_pred(S(S(n))), ba_add(m, k))
  by simp rw ba_add_assoc refl
lemma ba_d111 : forall n m k i. ba_w2(ba_w2(n, m), S(ba_w0(k, i))) = ba_add(ba_w2(n, m), ba_w0(k, i))
  by simp rw ba_pred_add_s refl
lemma ba_d112 : forall n m. ba_mul(ba_pred(ba_w0(n, m)), S(Z)) = ba_pred(ba_w0(n, m))
  by simp rw ba_d005 refl
lemma ba_d114 : forall n m. ba_even(ba_dbl(ba_w1(S(n), m))) = T
  by simp rw ba_even_dbl refl
lemma ba_d115 : forall n m. ba_add(S(ba_w0(n, m)), Z) = S(ba_w0(n, m))
  by simp rw ba_d003 simp refl
lemma ba_d116 : forall n m k i. ba_mul(ba_add(ba_add(n, m), k), i) = ba_add(ba_mul(ba_add(n, m), i), ba_mul(k, i))
  by rw ba_mul_add refl
lemma ba_d117 : forall n m. ba_even(ba_dbl(ba_add(Z, ba_w2(n, m)))) = T
  by simp rw ba_even_dbl refl
lemma ba_d118 : forall n. ba_pred(ba_add(Z, S(S(S(n))))) = ba_add(Z, S(S(n)))
  by simp refl
lemma ba_d119 : forall n m. ba_add(S(ba_w0(n, m)), Z) = ba_add(Z, S(ba_w0(n, m)))
  by simp rw ba_d003 simp refl
lemma ba_d120 : forall n m k. ba_mul(ba_mul(ba_dbl(n), m), k) = ba_mul(ba_dbl(n), ba_mul(m, k))
  by rw ba_mul_assoc refl
lemma ba_d121 : forall n m k. ba_add(ba_w2(n, m), k) = ba_add(k, ba_pred(ba_add(n, m)))
  by simp rw ba_add_comm refl
lemma ba_d123 : forall n m. ba_add(ba_add(ba_dbl(n), m), Z) = ba_add(Z, ba_add(ba_dbl(n), m))
  by simp rw ba_d045 simp refl
lemma ba_d124 : forall n m k. ba_w2(n, S(ba_w0(m, k))) = ba_add(n, ba_w0(m, k))
  by simp rw ba_pred_add_s refl
lemma ba_d125 : forall n m. ba_dbl(ba_sub(n, ba_w2(m, Z))) = ba_add(ba_sub(n, ba_w2(m, Z)), ba_sub(n, ba_w2(m, Z)))
  by simp rw ba_d049 refl
lemma ba_d126 : forall n m k i. ba_neg(ba_neg(ba_w3(n, ba_tri(ba_w2(m, ba_w2(k, i)))))) = ba_w3(n, ba_tri(ba_w2(m, ba_w2(k, i))))
  by simp rw ba_neg_neg refl
lemma ba_d127 : ba_even(S(S(S(S(Z))))) = ba_even(S(S(Z)))
  by simp refl
lemma ba_d129 : forall n. ba_dbl(ba_sub(S(n), Z)) = ba_add(ba_sub(S(n), Z), ba_sub(S(n), Z))
  by simp rw ba_dbl_add rw ba_add_s_r refl
lemma ba_d131 : forall n m. ba_even(ba_dbl(ba_add(n, S(m)))) = T
  by rw ba_d002 refl
lemma ba_d132 : forall n m. ba_w4(n, m) = ba_tri(ba_sub(n, m))
  by simp refl
lemma ba_d133 : forall n. ba_w5(n) = ba_pred(n)
  by simp refl
lemma ba_d134 : forall n m. ba_w6(n, m) = ba_add(ba_w5(n), ba_w5(m))
  by simp refl
lemma ba_d135 : forall n m k. ba_w7(n, m, k) = ba_w2(n, ba_add(m, k))
  by simp refl
lemma ba_d136 : forall n. ba_sub(Z, ba_tri(ba_w1(n, Z))) = Z
  by simp rw ba_d032 refl
lemma ba_d138 : forall n m k i. ba_even(ba_w0(ba_w4(n, m), ba_sub(k, i))) = T
  by simp rw ba_d078 refl
lemma ba_d139 : forall n m. ba_neg(ba_neg(ba_w3(ba_dbl(n), ba_tri(m)))) = ba_w3(ba_dbl(n), ba_tri(m))
  by simp rw ba_neg_neg refl
